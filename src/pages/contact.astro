---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
import ContactForm from "../components/ContactForm.astro";
import Section from "../components/Section.astro";
import contact_data from "../data/contact.json";
---

<Layout>
	<Section section={contact_data} />
	<div class="flex gap-6">
		<div class="p-4">
			<p class="text-2xl font-bold font-serif">Send Us a Message</p>
			<p>
				Fill in the form, and we'll get back with you as soon as
				possible.
			</p>
			<div>
				<ContactForm
					subject="Contact Request from Veteran John website"
				/>
				<p class="text-xs">We respect your privacy. No spam ever.</p>
			</div>
		</div>
		<div class="flex gap-4">
			<div class="p-4">
				<p class="text-2xl font-serif font-bold">Other Ways to Reach Us</p>

				<div class="flex gap-4 py-4">
					<div>
						<img class="w-8 h-8 mb-4" src="/icons/phone.svg" />
					</div>
					<div>
						<p class="font-bold">Phone</p>
						<p></p>
						<p>We're happy to talk and answer your questions.</p>
					</div>
				</div>
				<div class="flex gap-4 py-4">
					<div>
						<img class="w-8 h-8 mb-4" src="/icons/envelope.svg" />
					</div>
					<div>
						<p class="font-bold">Email</p>
						<p><a class="underline" href="mailto:Outreach@VeteranJohn.org">Outreach@VeteranJohn.org</a></p>
						<p>We typically respond in 1-2 business days.</p>
					</div>
				</div>
				<div class="flex gap-4 py-4">
					<div>
						<img class="w-8 h-8 mb-4" src="/icons/location.svg" />
					</div>
					<div>
						<p class="font-bold">Our Location</p>
						<p>Fort Worth, Texas</p>
						<p>
							We serve veterans and communities throughout the
							region.
						</p>
					</div>
				</div>
				<div class="flex gap-4 py-4">
					<div>
						<img class="w-8 h-8 mb-4" src="/icons/clock.svg" />
					</div>
					<div>
						<p class="font-bold">Office Hours</p>
						<p>Monday - Friday</p>
						<p>9:00 AM - 5:00 PM (CST)</p>
						<p>
							We're here during regular business hours, but you
							can always send us a message anytime.
						</p>
					</div>
				</div>
			</div>
		</div>
	</div>
</Layout>
