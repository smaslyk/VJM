---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
import section_data from "../data/donate.json";
import faq_data from "../data/faq.json";
import Section from "../components/Section.astro";
import Accordion from "../components/Accordion.astro";
---

<Layout>
    <Section section={section_data} />
    <div>
    <p class="text-4xl">Frequently asked questions</p>
    <p class="text-sm">Quick answers to common questions about giving.</p>

    {
        faq_data.faq.map((faq: { question: string; answer: string }) => (
            <Accordion title={faq.question}>
                <p>{faq.answer}</p>
            </Accordion>
        ))
    }
    </div>
</Layout>
