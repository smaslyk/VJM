---
const { section } = Astro.props;
import LearnMore from '../components/LearnMore.astro';
---

<div>
    <div class="relative overflow-hidden flex">
        <video
            src="/videos/flag.mp4"
            controlslist="nodownload noplaybackrate nofullscreen noremoteplayback"
            class="absolute left-1/2 -translate-x-1/2 -translate-y-1/2 object-cover z-0"
            autoplay=""
            muted=""
            loop=""
            playsinline=""
            webkit-playsinline=""
            disablepictureinpicture=""></video>
        <div
            class="relative z-20 p-8 mx-4 bg-white/10 backdrop-blur-md rounded-2xl border border-white/20 shadow-2xl"
        >
            <h1
                class="text-2xl md:text-6xl font-bold mb-4 text-blue-950 max-w-lg font-serif"
            >
                {section.title}
            </h1>
            <div
                class="m-4 p-4 mb-4 text-sm bg-slate-800 text-slate-200 max-w-80 rounded-lg"
            >
                {section.body}
            </div>
            <div class="flex gap-4">
                {
                    section.buttons.map(
                        (button: {
                            text: string;
                            link: string;
                            image: string;
                        }) => (
                            <a
                                class="inline-block rounded bg-blue-950 px-6 py-2.5 text-sm font-medium text-slate-50 border-2 border-white shadow transition duration-200 ease-in-out hover:bg-blue-700 hover:shadow-lg focus:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2"
                                href={button.link}
                            >
                                <img
                                    src={button.image}
                                    alt={button.text}
                                    class="inline-block mr-2 w-8 h-8"
                                />
                                {button.text}
                            </a>
                        ),
                    )
                }
            </div>
        </div>
    </div>
    <div>
        {
            section.blocks.map(
                (block: {
                    title: string;
                    subtitle: string;
                    body: string;
                    deck: {
                        title: string;
                        subtitle: string;
                        body: string;
                        image: string;
                        icon?: string;
                    }[];
                }) => (
                    <div class="rounded overflow-hidden shadow-lg p-4 bg-slate-50 font-serif">
                        <h2 class="font-bold text-xl md:text-4xl mb-2">{block.title}</h2>
                        <p class="text-md">{block.subtitle}</p>
                        <div class="flex flex-col md:flex-row gap-2 mt-4">
                            {block.deck.map(
                                (card: {
                                    title: string;
                                    subtitle: string;
                                    body: string;
                                    image: string;
                                    icon?: string;
                                    post_html?: string;
                                    learn_more?: boolean;
                                }) => (
                                    <div class="inline-block flex flex-col md:flex-row max-w-sm mx-0 my-0 overflow-hidden shadow-lg rounded-lg bg-white items-center py-0 px-0">
                                        {card.image && (
                                            <div>
                                                <img
                                                    src={card.image}
                                                    alt={card.title}
                                                    class="mb-4 object-fill w-full h-full object-center"
                                                />
                                            </div>
                                        )}
                                        {(card.title ||
                                            card.subtitle ||
                                            card.icon) && (
                                            <div class="px-2 py-0 flex gap-2 items-center">
                                                {card.icon && (
                                                    <div class="shrink-0">
                                                        <img
                                                            src={card.icon}
                                                            alt={card.title}
                                                            class="w-12 h-12 mb-4"
                                                        />
                                                    </div>
                                                )}
                                                {(card.title ||
                                                    card.subtitle) && (
                                                    <div class="grow">
                                                        <h3 class="font-bold text-xl mb-2">
                                                            {card.title}
                                                        </h3>
                                                        <p class="text-gray-700 text-xs preserve-breaks">
                                                            {card.subtitle}
                                                        </p>
                                                        {card.learn_more && <LearnMore content={card.learn_more} />}
                                                        {card.post_html && (
                                                            <p class="px-2 py-0">
                                                                <p
                                                                    set:html={
                                                                        card.post_html
                                                                    }
                                                                />
                                                            </p>
                                                        )}
                                                    </div>
                                                )}
                                            </div>
                                        )}
                                    </div>
                                ),
                            )}
                        </div>
                    </div>
                ),
            )
        }
    </div>
</div>
<style>
    .preserve-breaks {
        white-space: pre-line;
    }
</style>
