---
const {section} = Astro.props;
---
<div style="background-color: {section.background_color}; color: {section.text_color}; padding: 2rem; width:100%;">
<h1 class="text-3xl font-bold mb-4">{section.title}</h1>
    <div class="mb-4" style="font-size: 1.25rem;">
        {section.body}
    </div>
    <div>
    {section.buttons.map((button: { text: string; link: string }) => (
        <a class="inline-block rounded bg-blue-600 px-6 py-2.5 text-sm font-medium text-white shadow transition duration-200 ease-in-out hover:bg-blue-700 hover:shadow-lg focus:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2" href={button.link}>{button.text}</a>
    ))}

{section.blocks.map((block: { title: string; subtitle: string; body: string; deck: { title: string; subtitle: string; body: string; image: string }[] }) => (
        <div class="rounded overflow-hidden shadow-lg">
            <h2 class="font-bold text-xl mb-2">{block.title}</h2>
            <p class="text-gray-700 text-sm">{block.subtitle}</p>
            <div class="flex flex-wrap gap-4 mt-4">
            {block.deck.map((card: { title: string; subtitle: string; body: string; image: string; icon: string; }) => (
                <div class="inline-block max-w-sm overflow-hidden shadow-lg p-6 rounded-lg shadow bg-white">
                    <div class="px-6 py-4">

                        {card.icon && (
                            <img src={card.icon} alt={card.title}  class="w-12 h-12 mb-4" />
                        )}

                        <h3 class="font-bold text-xl mb-2">{card.title}</h3>
                        <p class="text-gray-700 text-xs">{card.subtitle}</p>
                    </div>
                </div>
            ))}
            </div>
        </div>
    ))}

    </div>
</div>
