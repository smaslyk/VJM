---
// src/components/Accordion.astro
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<details class="accordion-item border border-gray-200 rounded-lg mb-2 overflow-hidden">
  <summary class="font-medium p-4 cursor-pointer bg-gray-50 hover:bg-gray-100 transition-colors select-none">
    {title}
  </summary>
  <div class="p-4 bg-white border-t border-gray-200">
    <slot />
  </div>
</details>

<style>
  /* Optional smooth marker styling or animations */
  details summary::-webkit-details-marker {
    display: none;
  }
</style>
