---
const { prefooter_data } = Astro.props;
---

<div class="flex gap-4 mt-4 py-4 bg-slate-300">
    <div class="p-4"><img src={prefooter_data.icon} class="w-12 h-12" /></div>
    <div class="w-7/12 p-4"><p class="text-2xl font-bold font-serif">{prefooter_data.title}</p><p class="text-sm" set:html={prefooter_data.body}></p></div>
    <div class="p-4"><p  set:html={prefooter_data.html} /></div>
</div>
