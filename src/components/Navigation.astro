---
// src/components/Navbar.astro
const navItems = [
  { name: "Home", href: "/" },
  { name: "About VJO", href: "/about_vjo" },
  { name: "Our Outreach", href: "/our_outreach" },
  { name: "Bios & Updates", href: "/bios" },
  { name: "Get Involved", href: "/get_involved" },
  { name: "Give", href: "/give" },
  { name: "Contact", href: "/contact" },
];
---
<nav class="text-blue-950 bg-white sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      
      <!-- Logo -->
      <div class="shrink-0">
        <a href="/" class="text-xl font-bold tracking-wider text-blue-950">VJO logo</a>
      </div>

      <!-- Desktop Menu -->
      <div class="hidden md:flex space-x-8">
        {navItems.map((item) => (
          <a 
            href={item.href} 
            class="text-sm font-medium text-blue-950 hover:text-red-700 transition-colors duration-200"
          >
            {item.name}
          </a>
        ))}
      </div>

      <!-- Mobile Menu Toggle (Hidden Checkbox Hack) -->
      <label for="menu-toggle" class="cursor-pointer md:hidden block p-2 text-slate-400 hover:text-white">
        <input type="checkbox" id="menu-toggle" class="hidden peer" />
        
        <!-- Hamburger Icon -->
        <svg class="h-6 w-6 block peer-checked:hidden" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
        
        <!-- Close Icon -->
        <svg class="h-6 w-6 hidden peer-checked:block" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
        </svg>

        <!-- Mobile Drawer Container (Triggers via Peer) -->
        <div class="absolute top-16 left-0 right-0 bg-slate-950 border-b border-slate-800 hidden peer-checked:flex flex-col p-4 space-y-3 shadow-xl md:hidden">
          {navItems.map((item) => (
            <a 
              href={item.href} 
              class="text-base font-medium text-slate-300 hover:text-white py-2 px-3 rounded-md hover:bg-slate-900 transition-colors"
            >
              {item.name}
            </a>
          ))}
        </div>
      </label>

    </div>
  </div>
</nav>
